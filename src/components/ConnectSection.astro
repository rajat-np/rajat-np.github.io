---
import ContactForm from "@components/ContactForm";
import { SOCIALS } from "@/config";
---

<div class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 py-8 mt-12">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white">Let’s Connect</h2>
      <p class="text-base text-slate-700 dark:text-slate-400 max-w-3xl mx-auto">
        Whether you're hiring, collaborating, or just want to chat about systems and impact—I’d love to hear from you!
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
      <ContactForm client:load />

      <div class="flex items-center gap-4">
        <div class="h-8 w-px bg-slate-300 dark:bg-slate-700 hidden sm:block"></div>
        <p class="text-slate-700 dark:text-slate-400 text-sm hidden sm:block">or find me on</p>
      </div>

      <div class="flex gap-4">
        <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70" aria-label="GitHub">
          <img src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/github.svg" alt="GitHub" class="w-6 h-6 opacity-60 dark:invert" />
        </a>
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70" aria-label="LinkedIn">
          <img src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/linkedin.svg" alt="LinkedIn" class="w-6 h-6 opacity-60 dark:invert" />
        </a>
        <a href={SOCIALS.stackoverflow} target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70" aria-label="Stack Overflow">
          <img src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/stackoverflow.svg" alt="Stack Overflow" class="w-6 h-6 opacity-60 dark:invert" />
        </a>
        <a href={SOCIALS.flickr} target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70" aria-label="Flickr">
          <img src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/flickr.svg" alt="Flickr" class="w-6 h-6 opacity-60 dark:invert" />
        </a>
      </div>
    </div>
  </div>
</div>
