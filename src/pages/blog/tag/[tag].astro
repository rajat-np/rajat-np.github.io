---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = new Set<string>();

  posts.forEach((post) => {
    if (post.data.draft) return;
    post.data.tags.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = (await getCollection("blog")).filter((post) => !post.data.draft);
const taggedPosts = allPosts.filter((post) => post.data.tags.includes(tag));
const sortedPosts = taggedPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={`#${tag}`}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="mb-10">
      <p class="text-sm uppercase tracking-[0.25em] text-emerald-600 font-semibold">Tag</p>
      <h1 class="text-4xl font-bold mb-3 text-slate-900 dark:text-white">#{tag}</h1>
      <p class="text-lg text-slate-700 dark:text-slate-300">
        {sortedPosts.length} post{sortedPosts.length === 1 ? "" : "s"} tagged with #{tag}.
      </p>
    </div>

    {sortedPosts.length === 0 ? (
      <p class="text-lg text-slate-700 dark:text-slate-400">
        No posts found for this tag.
      </p>
    ) : (
      <div class="space-y-6">
        {sortedPosts.map((post) => (
          <article class="rounded-2xl border border-emerald-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/70 p-6 shadow-sm">
            <a href={`/blog/${post.slug}`} class="group">
              <h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-slate-700 dark:text-slate-300 mb-3 leading-relaxed">
                {post.data.description}
              </p>
              <time class="text-sm text-slate-500 dark:text-slate-400">
                {post.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </a>
          </article>
        ))}
      </div>
    )}

    <div class="mt-10">
      <a href="/blog" class="text-emerald-600 dark:text-emerald-400 hover:underline">
        ← Back to all posts
      </a>
    </div>
  </div>
</Layout>
