---
import Layout from "@layouts/Layout.astro";
import { SOCIALS } from "@/config";
---

<Layout
  headerClass="py-2"
  footerClass="py-4"
  mainClass="flex items-center"
>
  <div class="max-w-5xl mx-auto px-6 py-[clamp(5rem,12vh,9rem)] w-full">
    <div class="max-w-2xl text-center mx-auto">
      <h1
        class="text-[clamp(2.6rem,6vw,3.6rem)] font-semibold text-slate-900 dark:text-slate-100 tracking-tight leading-tight"
      >
        Rajat Soni
      </h1>
      <p class="mt-3 text-[clamp(1rem,2vw,1.1rem)] font-medium text-emerald-700/90 dark:text-emerald-300/90">
        Senior Software Engineer @ Treeconomy
      </p>
      <p class="mt-6 text-[clamp(1rem,2.2vw,1.15rem)] text-slate-600 dark:text-slate-300 leading-relaxed">
        Full Stack software engineer focused on building scalable backend systems and modern web applications. Skilled in Python, Node.js, and Go for
        high-performance services, with React for responsive frontends. Experienced with MongoDB, PostgreSQL, Elasticsearch, and Redis with a focus on building efficient data pipelines and integrating AI-driven workflows.
      </p>
      <div class="mt-12 flex justify-center gap-5">
        <a
          href={SOCIALS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-opacity hover:opacity-70"
          aria-label="GitHub"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/github.svg"
            alt="GitHub"
            class="w-5 h-5 opacity-60 dark:invert"
          />
        </a>
        <a
          href={SOCIALS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-opacity hover:opacity-70"
          aria-label="LinkedIn"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/linkedin.svg"
            alt="LinkedIn"
            class="w-5 h-5 opacity-60 dark:invert"
          />
        </a>
        <a
          href={SOCIALS.stackoverflow}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-opacity hover:opacity-70"
          aria-label="Stack Overflow"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/stackoverflow.svg"
            alt="Stack Overflow"
            class="w-5 h-5 opacity-60 dark:invert"
          />
        </a>
        <a
          href={SOCIALS.flickr}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-opacity hover:opacity-70"
          aria-label="Flickr"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@3.0.1/icons/flickr.svg"
            alt="Flickr"
            class="w-5 h-5 opacity-60 dark:invert"
          />
        </a>
      </div>
    </div>
  </div>
</Layout>
